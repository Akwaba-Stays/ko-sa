# --- App ---
NEXT_PUBLIC_SITE_URL=https://ko-sa.com

# --- Deployment target (see DEPLOYMENT.md) ---
# all  = single deployment serving public site + admin (default / local dev)
# site = public marketing site only (admin paths 404 or redirect to ADMIN_URL)
# admin= admin dashboard only (public paths redirect to SITE_URL)
APP_TARGET=all
# When split across two hosts, point each at the other so cross-surface links resolve:
# SITE_URL=https://ko-sa.com
# ADMIN_URL=https://admin.ko-sa.com

# --- Database (Supabase Postgres) ---
DATABASE_URL=postgresql://user:pass@host:5432/kosa
DIRECT_URL=postgresql://user:pass@host:5432/kosa

# --- NextAuth ---
NEXTAUTH_SECRET=replace_me_32chars
NEXTAUTH_URL=https://ko-sa.com
ADMIN_EMAIL=admin@ko-sa.com
ADMIN_PASSWORD_HASH=

# --- Sanity ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# --- Cloudbeds ---
CLOUDBEDS_CLIENT_ID=
CLOUDBEDS_CLIENT_SECRET=
CLOUDBEDS_PROPERTY_ID=
CLOUDBEDS_REDIRECT_URI=https://ko-sa.com/api/cloudbeds/callback

# --- Paystack / Stripe (fallback) ---
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=

# --- Email ---
RESEND_API_KEY=
FROM_EMAIL=bookings@ko-sa.com

# --- Google Drive (virtual tour) ---
GOOGLE_DRIVE_SERVICE_ACCOUNT=
GOOGLE_DRIVE_VIRTUAL_TOUR_FOLDER=1ftwKHClfkQPhlsCOP_-G2QkCQSrbC9D3

# --- Cloudinary ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- AI (OpenRouter — primary; Anthropic optional) ---
OPENROUTER_API_KEY=
OPENROUTER_MAIN_MODEL=google/gemma-4-31b-it:free
OPENROUTER_FALLBACK_MODEL_1=google/gemma-4-26b-a4b-it:free
OPENROUTER_FALLBACK_MODEL_2=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
ANTHROPIC_API_KEY=

# --- Supabase Realtime ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin / NextAuth ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=                     # openssl rand -base64 32
# Bootstrap: first sign-in with these creates the OWNER admin user; remove after first login
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# --- Analytics ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
